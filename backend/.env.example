# CeylonGo Backend - Local Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.

# Application Settings
PROJECT_NAME="CeylonGo Shared API"
DEBUG=True
API_AUTH_PREFIX="/api/auth"

# Security & JWT Configuration
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace_this_with_a_secure_random_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (JSON array of allowed origins)
# For local Angular development
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Login Rate Limiting (Single-Process Sliding Window)
# Maximum failed attempts within the window before returning 429
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_IPS=10000

# Database Configuration (Microsoft SQL Server 2022 / ODBC Driver 18)
# If unconfigured, the application runs in safe fallback mode (503 Service Unavailable).
# NOTE: TrustServerCertificate=yes is strictly for local development without custom CA certificates;
# production environments must validate server certificates using proper CA chains.
#
# Option A: Standard SQL Server Authentication (TCP Port 1433)
# DATABASE_URL="mssql+pyodbc://sa:YourPassword123@localhost:1433/CeylonGoDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"
#
# Option B: Named Instance (e.g., SQLEXPRESS) with Windows Authentication
# DATABASE_URL="mssql+pyodbc://@localhost\SQLEXPRESS/CeylonGoDB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes"
#
# Option C: LocalDB with Windows Authentication
# DATABASE_URL="mssql+pyodbc://@(localdb)\MSSQLLocalDB/CeylonGoDB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes"

# Integration Testing Database Configuration (Multi-layer Safety Isolation)
# Integration tests NEVER run against the primary DATABASE_URL or CeylonGoDB.
# To execute integration tests, you MUST explicitly set RUN_SQL_SERVER_INTEGRATION_TESTS=1
# AND configure an isolated, non-production test database.
# RUN_SQL_SERVER_INTEGRATION_TESTS=0
# TEST_DATABASE_URL="mssql+pyodbc://sa:YourPassword123@localhost:1433/CeylonGoDB_Test?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"
