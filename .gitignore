# =============================================================================
# CeylonGo Backend - Root .gitignore
# Python FastAPI / SQLAlchemy / Microsoft SQL Server
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
.env
.env.*
.env.local
.env.development
.env.test
.env.production
# Explicitly preserve example configuration templates
!.env.example
!backend/.env.example

# Cryptographic certificates, keys, and credentials
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer

# Unit test and coverage artifacts
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Type checking and linters cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Local database files, SQLite databases, and MSSQL backups
*.sqlite3
*.db
*.bak
*.sql.bak
*.mdf
*.ldf

# Generated log files
*.log
logs/

# Security audit and reporting artifacts
*gitleaks*.json
gitleaks-report.json

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
